{
  "_about": "Where REELIX finds its free local models. scripts/setup.sh installs them under {models} (default ~/.reelix). A laptop can override any value in config/models.local.json (not in git), e.g. to use models that already live in another folder: scripts/setup.sh --use-existing <folder>.",
  "models": "~/.reelix",
  "image": {
    "engine": "FLUX.1 schnell 4-bit (Apache-2.0, commercial OK)",
    "bin": "{models}/venv-image/bin/mflux-generate",
    "model": "{models}/flux1-schnell-4bit",
    "steps": 4
  },
  "voice": {
    "engine": "Kokoro-82M (Apache-2.0)",
    "bin": "{models}/venv-voice/bin/mlx_audio.tts.generate",
    "model": "mlx-community/Kokoro-82M-bf16",
    "voices": {
      "narrator-male": "bm_george",
      "narrator-female": "bf_emma",
      "man-1": "am_michael",
      "man-2": "am_adam",
      "man-3": "bm_lewis",
      "woman-1": "af_heart",
      "woman-2": "af_bella"
    }
  },
  "captions": {
    "engine": "whisper.cpp large-v3-turbo",
    "bin": "whisper-cli",
    "model": "~/.cache/whisper/ggml-large-v3-turbo-q5_0.bin"
  },
  "music": {
    "engine": "ACE-Step 1.5 (Apache-2.0)",
    "dir": "{models}/ace-step",
    "api": "http://127.0.0.1:8001"
  },
  "notUsed": {
    "flux-kontext-q4": "non-commercial licence",
    "edge-tts": "no commercial licence"
  },
  "cutout": {
    "bin": "{models}/bin/cutout",
    "about": "Apple Vision subject cut-out for 2.5D parallax"
  }
}